{
  "permissions": {
    "allow": [
      "Bash(composer outdated *)",
      "Bash(composer show *)",
      "Bash(php composer.phar outdated --direct)",
      "Bash(php -r \"passthru\\('composer outdated --direct'\\);\")",
      "Bash(php artisan *)",
      "Bash(php -r \"passthru\\('composer remove genealabs/laravel-model-caching --no-update'\\);\")",
      "Bash(php -r \"passthru\\('composer require mike-bronner/laravel-model-caching'\\);\")",
      "Bash(php -r \"passthru\\('composer require mike-bronner/laravel-model-caching --no-update'\\);\")",
      "Bash(php -r \"passthru\\('composer update --with-all-dependencies --ignore-platform-reqs'\\);\")"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "laravel-boost"
  ]
}
