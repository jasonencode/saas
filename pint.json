{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "none"
        },
        "not_operator_with_successor_space": false,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "trailing_comma_in_multiline": true,
        "single_quote": true,
        "phpdoc_order": true,
        "phpdoc_separation": true,
        "phpdoc_trim": true,
        "braces_position": {
            "anonymous_classes_opening_brace": "same_line"
        }
    },
    "exclude": [
        "vendor",
        "storage",
        "bootstrap/cache"
    ],
    "not-name": [
        "*.blade.php"
    ]
}
